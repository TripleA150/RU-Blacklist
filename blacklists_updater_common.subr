#!/bin/sh
# shellcheck shell=sh disable=SC2034  # variables are used by the sourcing scripts

# Shared config for blacklists_updater_*.sh scripts.
# Scripts are expected to define SCRIPT_DIR and enable "set -eu" before sourcing this file.

: "${SCRIPT_DIR:?SCRIPT_DIR must be set before sourcing blacklists_updater_common.subr}"

PYTHON="${PYTHON:-python3}"

BLACKLISTS_DIR="${SCRIPT_DIR}/blacklists"
AUTO_DIR="${SCRIPT_DIR}/auto"
LISTS_DIR="${SCRIPT_DIR}/lists"

BLACKLIST_FILE="${BLACKLISTS_DIR}/blacklist.txt"
BLACKLIST_WITH_COMMENTS_FILE="${BLACKLISTS_DIR}/blacklist_with_comments.txt"
BLACKLIST_V4_FILE="${BLACKLISTS_DIR}/blacklist-v4.txt"
BLACKLIST_V6_FILE="${BLACKLISTS_DIR}/blacklist-v6.txt"
BLACKLIST_VK_FILE="${BLACKLISTS_DIR}/blacklist-vk.txt"
BLACKLIST_VK_V4_FILE="${BLACKLISTS_DIR}/blacklist-vk-v4.txt"
BLACKLIST_VK_V6_FILE="${BLACKLISTS_DIR}/blacklist-vk-v6.txt"

AUTO_ALL_ASN_FILE="${AUTO_DIR}/all-ru-asn.txt"
AUTO_ALL_V4_FILE="${AUTO_DIR}/all-ru-ipv4.txt"
AUTO_ALL_V6_FILE="${AUTO_DIR}/all-ru-ipv6.txt"
AUTO_RIPE_V4_FILE="${AUTO_DIR}/ripe-ru-ipv4.txt"
AUTO_BLACK_ASS_FILE="${AUTO_DIR}/black_ass.txt"

NETWORK_LIST_FROM_AS="${SCRIPT_DIR}/network_list_from_as.py"
NETWORK_LIST_FROM_NETNAME="${SCRIPT_DIR}/network_list_from_netname.py"
AGGREGATE_PREFIXES="${SCRIPT_DIR}/aggregate_prefixes.py"
RU_GOV_NETNAMES_FILE="${LISTS_DIR}/ru-gov-netnames.txt"
ALLOWLIST_FILE="${LISTS_DIR}/allowlist.txt"
VK_NAME_EXCLUDE_FILE="${LISTS_DIR}/vk-exclude.txt"

# Header lines that change on every run; ignored when deciding whether a file changed.
TIMESTAMP_LINE_RE='^# (Last updated|Generated):'

# Print the non-comment, non-empty lines of a file.
read_list() {
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^#/d' -e '/^$/d' "$1"
}

# Print the patterns of a file joined with "|"; fails if the file has none,
# because an empty pattern would match every line.
read_patterns() {
    _patterns="$(read_list "$1" | paste -s -d '|' -)"
    if [ -z "${_patterns}" ]; then
        echo "ERROR: no patterns in $1" >&2
        return 1
    fi
    printf '%s\n' "${_patterns}"
}

BLACK_NAMES="$(read_patterns "${LISTS_DIR}/black-names.txt")"
WHITE_NAMES="$(read_patterns "${LISTS_DIR}/white-names.txt")"
VK_NAME_PATTERN="$(read_patterns "${LISTS_DIR}/vk-names.txt")"

# Scratch space inside the repo, so publishing with mv is an atomic rename.
WORK_DIR="$(mktemp -d "${SCRIPT_DIR}/.build.XXXXXX")"
trap 'rm -rf "${WORK_DIR}"' EXIT
trap 'exit 130' INT TERM

ensure_blacklist_base_dirs() {
    mkdir -p "${BLACKLISTS_DIR}" "${AUTO_DIR}"
}

# Print a fresh temp file path inside WORK_DIR.
make_tmp() {
    mktemp "${WORK_DIR}/tmp.XXXXXX"
}

# Move $1 over $2, unless the two differ only in timestamp header lines
# (then $2 is left untouched and no needless commit happens).
publish_file() {
    if [ -f "$2" ] && \
       [ "$(grep -vE "${TIMESTAMP_LINE_RE}" "$1" | cksum)" = "$(grep -vE "${TIMESTAMP_LINE_RE}" "$2" | cksum)" ]; then
        rm -f "$1"
        return 0
    fi
    chmod 644 "$1"
    mv -f "$1" "$2"
}

# aggregate_to OUTPUT [aggregate_prefixes.py args...]
# Validates, collapses and allowlist-filters prefixes, then publishes OUTPUT.
aggregate_to() {
    _output="$1"
    shift
    _tmp="$(make_tmp)"
    if [ -f "${ALLOWLIST_FILE}" ]; then
        set -- --exclude "${ALLOWLIST_FILE}" "$@"
    fi
    "${PYTHON}" "${AGGREGATE_PREFIXES}" -o "${_tmp}" "$@"
    publish_file "${_tmp}" "${_output}"
}

# Print the number of non-empty lines in a file.
count_lines() {
    grep -c . "$1" || true
}

build_vk_name_blacklists() {
    ensure_blacklist_base_dirs

    _vk_raw="$(make_tmp)"
    _vk_exclude="$(make_tmp)"
    if [ -f "${VK_NAME_EXCLUDE_FILE}" ]; then
        read_list "${VK_NAME_EXCLUDE_FILE}" > "${_vk_exclude}"
    fi

    for source_file in "${AUTO_ALL_V4_FILE}" "${AUTO_ALL_V6_FILE}" "${AUTO_RIPE_V4_FILE}"; do
        [ -f "${source_file}" ] || continue
        # ENVIRON instead of -v: awk -v would interpret backslash escapes in the pattern.
        VK_NAME_PATTERN="${VK_NAME_PATTERN}" awk 'tolower($0) ~ tolower(ENVIRON["VK_NAME_PATTERN"]) { print }' "${source_file}" \
            | { if [ -s "${_vk_exclude}" ]; then grep -viF -f "${_vk_exclude}" || true; else cat; fi; } \
            | awk '{ print $1 }' >> "${_vk_raw}"
    done

    aggregate_to "${BLACKLIST_VK_FILE}" "${_vk_raw}"
    aggregate_to "${BLACKLIST_VK_V4_FILE}" --family 4 "${BLACKLIST_VK_FILE}"
    aggregate_to "${BLACKLIST_VK_V6_FILE}" --family 6 "${BLACKLIST_VK_FILE}"
}
