# /etc/ru-blacklist.conf — settings for ru-blacklist-update (sourced as shell).

# Where to download blacklist-v4.txt and blacklist-v6.txt.
BASE_URL="https://raw.githubusercontent.com/TripleA150/RU-Blacklist/main/output/txt"

# Firewall backend: "nftables" or "ipset" (ipset + iptables/ip6tables).
BACKEND="nftables"

# Addresses/prefixes that are never blocked, space-separated (IPv4 and IPv6).
# Put your own admin IPs here if your ISP might end up in the lists.
ALLOW_PREFIXES=""

# Sanity checks: refuse suspicious lists and keep the current rules.
MIN_ENTRIES=300
MAX_SHRINK_PERCENT=50

# Cache of the last applied lists (used if a download fails).
STATE_DIR="/var/lib/ru-blacklist"
